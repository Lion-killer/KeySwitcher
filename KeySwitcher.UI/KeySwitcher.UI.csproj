<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows показує користувачеві саме FileDescription: у списку піктограм області сповіщень, у
         диспетчері задач, у властивостях файлу. Без цих двох рядків туди їде ім'я збірки —
         «KeySwitcher.UI», з технічним суфіксом, якого користувачеві знати не треба. -->
    <AssemblyTitle>KeySwitcher</AssemblyTitle>
    <Product>KeySwitcher</Product>
    <!-- NotifyIcon + System.Drawing.Bitmap come from the Microsoft.WindowsDesktop.App shared
         framework; no System.Drawing.Common NuGet package is needed for the tray icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Taskbar/dialog icon; the tray draws its own flags at runtime (TrayIconController). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WPF and WinForms ship localised satellite assemblies for ~20 languages — 13 folders, ~220 files,
         ~18 МБ — and the app never reads them: its own strings are Ukrainian, and the only Windows-provided
         strings it can show come from the OS. Without this the installed folder is a pile of cs/, de/,
         zh-Hant/ that nobody asked for. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeySwitcher.Core\KeySwitcher.Core.csproj" />
  </ItemGroup>

  <!-- ApplicationIcon embeds the Win32 icon; the Resource item puts the same file into the WPF
       resource stream, otherwise Icon="pack://application:,,,/app.ico" throws
       "Cannot locate resource 'app.ico'" when the settings window is created. -->
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- UseWindowsForms adds global usings for System.Windows.Forms/System.Drawing, which clash
       with the WPF types (Application, MessageBox, Window). The tray class imports them explicitly. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>


</Project>
