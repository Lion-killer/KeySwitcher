<Window x:Class="KeySwitcher.UI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeySwitcher — Налаштування"
        Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/app.ico"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B6B6B" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="26,2,0,14" />
        </Style>

        <Style x:Key="OptionBox" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style x:Key="HotkeyBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Width" Value="170" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="ContextMenu" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Padding="4">

            <TabItem Header="Загальні">
                <StackPanel Margin="14,12,14,6">
                    <CheckBox x:Name="AutoSwitchCheck" Style="{StaticResource OptionBox}"
                              Content="Автоперемикання розкладки" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Виправляти розкладку автоматично після введення слова." />

                    <CheckBox x:Name="AutoSwitchLayoutCheck" Style="{StaticResource OptionBox}"
                              Content="Перемикати розкладку після автозаміни" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Разом із виправленням слова змінювати системну мову. Вимкни, якщо перемикаєш її сам (Ctrl+Shift)." />

                    <CheckBox x:Name="FixCapsLockCheck" Style="{StaticResource OptionBox}"
                              Content="Виправляти помилковий CapsLock" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Інвертувати регістр слова, якщо CapsLock був увімкнений випадково." />

                    <CheckBox x:Name="SkipCaretMoveCheck" Style="{StaticResource OptionBox}"
                              Content="Не автоперемикати після клавіш керування курсором" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Після ← → ↑ ↓, Home, End, PgUp, PgDn пропустити найближче автоперемикання — у чужому тексті воно може зїсти не ті символи." />

                    <CheckBox x:Name="SkipManualSwitchCheck" Style="{StaticResource OptionBox}"
                              Content="Не автоперемикати після ручного перемикання" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Після Ins (ручного перемикання слова) або перемикання розкладки самим (Ctrl+Shift, Win+Space) пропустити найближче автоперемикання, щоб програма не сперечалася з твоїм вибором." />

                    <CheckBox x:Name="AutoStartCheck" Style="{StaticResource OptionBox}"
                              Content="Запускати з Windows" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Додати KeySwitcher до автозапуску поточного користувача." />

                    <CheckBox x:Name="VerboseLogCheck" Style="{StaticResource OptionBox}"
                              Content="Детальне логування" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Писати в debug.log кожне натискання й кожен оброблений символ. Потрібно, коли треба розібрати, чому слово не перемкнулося; вимкнене — лишаються лише рішення й механіка." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Гарячі клавіші">
                <Grid Margin="14,16,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Перемкнути останнє слово"
                               VerticalAlignment="Center" Margin="0,0,12,10" />
                    <TextBox x:Name="ManualSwitchBox" Grid.Row="0" Grid.Column="1"
                             Style="{StaticResource HotkeyBox}" Margin="0,0,8,10"
                             PreviewKeyDown="OnHotkeyBoxPreviewKeyDown" />
                    <Button Grid.Row="0" Grid.Column="2" Content="✕" Padding="8,4" Margin="0,0,0,10"
                            Click="OnClearHotkeyClick" Tag="ManualSwitchBox"
                            ToolTip="Прибрати комбінацію — гаряча клавіша не діятиме" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Змінити регістр"
                               VerticalAlignment="Center" Margin="0,0,12,10" />
                    <TextBox x:Name="ChangeCaseBox" Grid.Row="1" Grid.Column="1"
                             Style="{StaticResource HotkeyBox}" Margin="0,0,8,10"
                             PreviewKeyDown="OnHotkeyBoxPreviewKeyDown" />
                    <Button Grid.Row="1" Grid.Column="2" Content="✕" Padding="8,4" Margin="0,0,0,10"
                            Click="OnClearHotkeyClick" Tag="ChangeCaseBox"
                            ToolTip="Прибрати комбінацію — гаряча клавіша не діятиме" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Перемкнути розкладку виділеного"
                               VerticalAlignment="Center" Margin="0,0,12,10" />
                    <TextBox x:Name="SelectionLayoutBox" Grid.Row="2" Grid.Column="1"
                             Style="{StaticResource HotkeyBox}" Margin="0,0,8,10"
                             PreviewKeyDown="OnHotkeyBoxPreviewKeyDown" />
                    <Button Grid.Row="2" Grid.Column="2" Content="✕" Padding="8,4" Margin="0,0,0,10"
                            Click="OnClearHotkeyClick" Tag="SelectionLayoutBox"
                            ToolTip="Прибрати комбінацію — гаряча клавіша не діятиме" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Транслітерувати"
                               VerticalAlignment="Center" Margin="0,0,12,10" />
                    <TextBox x:Name="TransliterateBox" Grid.Row="3" Grid.Column="1"
                             Style="{StaticResource HotkeyBox}" Margin="0,0,8,10"
                             PreviewKeyDown="OnHotkeyBoxPreviewKeyDown" />
                    <Button Grid.Row="3" Grid.Column="2" Content="✕" Padding="8,4" Margin="0,0,0,10"
                            Click="OnClearHotkeyClick" Tag="TransliterateBox"
                            ToolTip="Прибрати комбінацію — гаряча клавіша не діятиме" />

                    <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource HintText}"
                               Margin="0,0,0,0"
                               Text="Клацніть у поле й натисніть потрібну комбінацію. Esc — повернути попередню. Порожнє поле (✕) — комбінацію вимкнено." />
                </Grid>
            </TabItem>

            <TabItem Header="Виключення">
                <Grid Margin="14,12,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#FF6B6B6B"
                               Text="У цих програмах KeySwitcher не втручається. Порівняння йде за назвою .exe." />

                    <ListView x:Name="ExclusionsList" Grid.Row="1" Height="150" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Програма" Width="340" DisplayMemberBinding="{Binding}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Відкриті вікна:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="OpenWindowsBox" Width="330" DisplayMemberPath="Display"
                                  DropDownOpened="OnOpenWindowsDropDownOpened"
                                  SelectionChanged="OnOpenWindowSelected"
                                  ToolTip="Виберіть програму зі списку — вона додасться до виключень. Список оновлюється при відкритті." />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Додати файл..." Click="OnAddExclusionFileClick"
                                Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Видалити" Click="OnRemoveExclusionClick" Padding="10,4" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Словник">
                <Grid Margin="14,12,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#FF6B6B6B"
                               Text="Власні слова, які автоперемикач не чіпає: імена, назви, терміни. Зберігаються у custom-words.txt, по одному в рядку; кирилиця йде в український словник, латиниця — в англійський." />

                    <ListView x:Name="PersonalWordsList" Grid.Row="1" Height="150" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Слово" Width="340" DisplayMemberBinding="{Binding}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox x:Name="PersonalWordBox" Width="330" Padding="6,3" VerticalContentAlignment="Center"
                                 KeyDown="OnPersonalWordKeyDown"
                                 ToolTip="Введіть слово і натисніть Enter або «Додати»." />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Додати" Click="OnAddPersonalWordClick" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Видалити" Click="OnRemovePersonalWordClick" Padding="10,4" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Автозаміна">
                <Grid Margin="14,12,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#FF6B6B6B"
                               Text="Скорочення замінюється повним текстом після пробілу, Tab або Enter. Рядки редагуються прямо в таблиці." />

                    <DataGrid x:Name="AutoReplaceGrid" Grid.Row="1" Height="150"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Скорочення" Binding="{Binding Shortcut}" Width="140" />
                            <DataGridTextColumn Header="Заміна" Binding="{Binding Replacement}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Додати" Click="OnAddAutoReplaceClick" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Видалити" Click="OnRemoveAutoReplaceClick" Padding="10,4" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Інше">
                <StackPanel Margin="14,12,14,10">
                    <TextBlock TextWrapping="Wrap" Foreground="#FF6B6B6B"
                               Text="Налаштування лежать у %AppData%\KeySwitcher\settings.json, власні слова — окремим файлом custom-words.txt поряд." />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Експортувати..." Click="OnExportClick" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Імпортувати..." Click="OnImportClick" Padding="10,4" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0"
                               Text="Експорт зберігає те, що зараз у вікні. Після імпорту перевірте значення — вони застосуються після «Зберегти»." />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Зберегти" Click="OnSaveClick" IsDefault="True"
                    MinWidth="100" Padding="10,4" Margin="0,0,8,0" />
            <Button Content="Скасувати" Click="OnCancelClick" MinWidth="100" Padding="10,4" />
        </StackPanel>
    </Grid>
</Window>
